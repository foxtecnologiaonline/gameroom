DATABASE_URL="postgresql://usuario:senha@localhost:5432/gameroom?schema=public"

# Só necessário quando DATABASE_URL aponta para um pooler (ex.: Supabase porta
# 6543/pgbouncer) — migrations exigem uma conexão direta (porta 5432), sem
# pooler, porque usam advisory locks incompatíveis com pgbouncer em modo
# transaction. Sem pooler (Postgres local, RDS direto), pode repetir o mesmo
# valor de DATABASE_URL aqui.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/gameroom?schema=public"

# Fila de jobs assíncronos: Upstash QStash (HTTP, sem Redis/worker
# persistente — necessário para rodar 100% na Vercel, que é serverless).
# QSTASH_URL: só em desenvolvimento local, aponta para `npx
# @upstash/qstash-cli dev` (deixe vazio em produção — usa o QStash real).
# QSTASH_TOKEN/QSTASH_CURRENT_SIGNING_KEY/QSTASH_NEXT_SIGNING_KEY: painel da
# Upstash (console.upstash.com/qstash) — em dev local com o CLI, use as
# chaves de dev que o próprio `qstash-cli dev` imprime ao iniciar.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL pública deste backend, usada para montar as URLs que o QStash chama de
# volta (ex.: https://gameroom-backend.vercel.app em produção,
# http://localhost:3000 em desenvolvimento).
APP_BASE_URL=http://localhost:3000

JWT_ACCESS_SECRET=troque_este_valor
JWT_REFRESH_SECRET=troque_este_valor
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chave de 32 bytes em base64 usada para cifrar codigo de licenca (AES-256-GCM).
# Gerar com: openssl rand -base64 32
CODIGO_ENCRYPTION_KEY=

# Segredo compartilhado com o gateway de pagamento para validar a assinatura HMAC do webhook
PAGAMENTO_WEBHOOK_SECRET=

RESERVA_EXPIRACAO_MINUTOS=15

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

PORT=3000
