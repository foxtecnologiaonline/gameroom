# Variáveis usadas pelo docker-compose.yml (raiz do projeto).
# Copie para `.env` (não versionado) e preencha antes de rodar `docker compose up`.
#
# As duas aplicações (backend/frontend) também têm seus próprios .env.example
# para rodar fora do Docker — ver backend/.env.example e frontend/.env.local.example.

POSTGRES_PASSWORD=gameroom_dev

# Gerar com: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CODIGO_ENCRYPTION_KEY=

# Segredo compartilhado com o gateway de pagamento para validar a assinatura HMAC do webhook
PAGAMENTO_WEBHOOK_SECRET=

# Fila de jobs (QStash) — ver backend/.env.example para o passo a passo de
# desenvolvimento local com `npx @upstash/qstash-cli dev`. Em produção,
# vêm do painel da Upstash (console.upstash.com/qstash).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_BASE_URL=http://localhost:3000

# Opcional — sem isso, upload de conteúdo (manuais/cartilhas/vídeos) falha
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# URL pública do backend, acessível pelo NAVEGADOR do cliente (não um hostname
# interno do Docker) — embutida no bundle do frontend em build time.
NEXT_PUBLIC_API_URL=http://localhost:3000
